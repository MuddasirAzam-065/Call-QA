# --- LLM Provider (OpenRouter) ---
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Any free-tier model slug from https://openrouter.ai/models?max_price=0
# Free 7-8B "instruct" models (like the default below) are the slowest and
# least reliable option - they run on shared, rate-limited free capacity and
# are more prone to malformed JSON output (which triggers this app's retry).
# For noticeably faster AND smarter results, swap in one of these:
#   google/gemini-2.0-flash-exp:free   -> still $0, much faster + smarter
#   meta-llama/llama-3.1-8b-instruct:free   -> default, slowest tier
# If you don't mind a small paid cost (usually a fraction of a cent per
# call), these are fast, cheap, and noticeably more capable/reliable:
#   openai/gpt-4o-mini
#   anthropic/claude-3.5-haiku
#   google/gemini-2.0-flash-001
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Optional - shown to OpenRouter for their leaderboard/analytics, not required
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_SITE_NAME=Call QA Mini Product

# --- Local model fallback (optional) ---
# If set to "true", the backend will call a local Ollama-compatible server
# instead of OpenRouter. Useful if your machine has enough CPU/RAM.
USE_LOCAL_MODEL=false
LOCAL_MODEL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL_NAME=llama3.1:8b

# --- Audio upload transcription (bonus feature) ---
# Runs locally on CPU via faster-whisper - no API key needed.
# Model downloads automatically (once) the first time you upload audio.
#   tiny  -> fastest, lower accuracy
#   base  -> fast, good for clear call audio (default, recommended to start)
#   small -> better accuracy, still fast on most laptops
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Lower = faster, slightly less accurate. 5 is faster-whisper's default;
# drop to 1 for a noticeable speed boost on longer audio files.
WHISPER_BEAM_SIZE=5

# --- App ---
# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Where QA history is persisted (simple JSON file store - swap for a real DB in production)
HISTORY_DB_PATH=./data/history.json
